    <string name="about_version">Version %1$s</string>

    <string name="about_app_title">About this app</string>
    <string name="about_app_body">Soundboard NG is an offline soundboard for theater, live events, and other productions. Organize sounds in multiple boards; play, pause, restart, and loop tracks; adjust volume and fades; and back up or restore your configuration and audio files.</string>

    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">Soundboard NG processes audio files and app settings locally on your device. The app does not transmit your data to the developer or use analytics, advertising, or tracking services. Android system backups may include certain app data depending on your device settings.</string>
    <string name="about_link_privacy">Privacy policy</string>

    <string name="about_508_title">Original project</string>
    <string name="about_508_body">Soundboard NG is a modified fork of Soundboard by 508.dev. The original project and its contributors retain credit for their work. This fork adds extended playback controls, multiple boards, configurable fades, and backup and restore features. It is not an official release of 508.dev.</string>

    <string name="about_link_repo">Source code</string>
    <string name="about_link_repo_url" translatable="false">https://github.com/lattemacchiato/soundboard</string>

    <string name="about_monetization_title">Open source</string>
    <string name="about_monetization_body">Soundboard NG is free software under the GNU General Public License version 3. Source code and modification history are available in the project repository.</string>

    <string name="about_link_508" translatable="false">508.dev</string>
    <string name="about_link_508_url" translatable="false">https://508.dev</string>

    <string name="about_licenses_summary">Open-source licenses for this app and its dependencies</string>
    <string name="about_license_line">Soundboard NG is based on Soundboard by 508.dev and is licensed under the GNU General Public License v3.</string>

    <!-- Licenses page -->
    <string name="licenses_app_title">Soundboard NG</string>
    <string name="licenses_app_body">Released under the GNU General Public License, version 3. You may use, study, share, and modify this app, provided derivative works carry the same license.</string>
    <string name="licenses_gpl_link">Read the GPL v3</string>
    <string name="licenses_third_party_title">Third-party components</string>
    <string name="licenses_apache_note">Components marked Apache License 2.0 are distributed under those terms; a copy is available at https://www.apache.org/licenses/LICENSE-2.0. Every dependency this app ships is free software.</string>

    <!-- Notification permission explanation (Android 13+) -->
    <string name="notification_permission_title">Playback notifications</string>
    <string name="notification_permission_message">Soundboard NG can continue playing sounds while the app is in the background or the screen is off.\n\nA notification lets you see when sounds are playing and stop all playback at any time.\n\nTo show this notification, Soundboard NG needs permission to send notifications.\n\nThis permission is optional. Sound playback works without it.</string>
